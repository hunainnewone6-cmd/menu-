# Server
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# Initial admin (used only by scripts/setup-admin.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# TOTP / 2FA
TOTP_ISSUER=KarachiBites

# Delivery
DELIVERY_CHARGE=150

# Database
DB_PATH=./data/karachi-bites.db
